<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The helper's LaunchDaemon, registered by the app with SMAppService.daemon. Lives in
     DarkCharge.app/Contents/Library/LaunchDaemons; BundleProgram is relative to the app. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.darkcharge.daemon</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/DarkChargeHelper</string>
    <key>ProgramArguments</key>
    <array>
        <string>DarkChargeHelper</string>
        <string>daemon</string>
    </array>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.darkcharge.app</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
